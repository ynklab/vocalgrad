{
  "step_duration_sec": 0.05,
  "context_duration_sec": 0.05,
  "crossfade_duration_sec": 0.005,
  "jump_at": 0.5,
  "tiers": {
    "low": {
      "cutoff_min_hz": 5000
    },
    "mid": {
      "cutoff_min_hz": 2500
    },
    "high": {
      "cutoff_min_hz": 1200
    }
  },
  "curves": {
    "linear": {
      "mode": "linear"
    },
    "quad_first_flat": {
      "mode": "quad_first_flat"
    },
    "quad_last_flat": {
      "mode": "quad_last_flat"
    },
    "jump": {
      "mode": "jump"
    }
  },
  "stft_kwargs": {
    "n_fft": 512,
    "hop_length": 128,
    "win_length": 512,
    "window": "hann",
    "center": true
  },
  "filter_profile": {
    "mode": "stft_lowpass",
    "transition_hz": 800,
    "preserve_rms": true
  }
}
